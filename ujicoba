                getMenuName(id) {
                    const m = this.menus.find(x => x.id === id);
                    return m ? m.name : '';
                },
                printSection(section) {
                    document.body.classList.remove('print-sampul','print-rekap','print-raport');
                    document.body.classList.add('print-' + section);
                    const cleanup = () => { document.body.classList.remove('print-sampul','print-rekap','print-raport'); window.removeEventListener('afterprint', cleanup); };
                    window.addEventListener('afterprint', cleanup);
                    window.print();
                },
                exportRekapCSV(kelas) {
                    if (!kelas) { alert('Pilih kelas terlebih dahulu.'); return; }
                    const headers = ['Nama Siswa', ...this.subjects.map(m => m.name)];
                    const rows = this.students.filter(st => st.kelas === kelas).map(st => [st.nama, ...this.subjects.map(m => this.getGrade(st.id, m.name).akhir || 0)]);
                    const csv = [headers, ...rows].map(row => row.map(v => '"' + String(v ?? '').replace(/"/g, '""') + '"').join(',')).join('\r\n');
                    const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
                    const url = URL.createObjectURL(blob); const a = document.createElement('a');
                    a.href = url; a.download = 'Rekap_Nilai_' + String(kelas).replace(/[^a-z0-9_-]+/gi, '_') + '.csv';
                    document.body.appendChild(a); a.click(); a.remove(); URL.revokeObjectURL(url);
                },
                initData() {
                    const saved = localStorage.getItem('sdn_dadirejo_02_data');
                    if (saved) {
                        try {
                            const parsed = JSON.parse(saved);
                            this.students = parsed.students || this.students;
                            this.classesList = parsed.classesList || this.classesList;
                            this.classTeachers = parsed.classTeachers || this.classTeachers || {};
                            this.subjects = parsed.subjects || this.subjects;
                            this.learningObjectives = parsed.learningObjectives || this.learningObjectives;
                            this.extracurriculars = parsed.extracurriculars || this.extracurriculars;
                            this.kokurikulerProjects = parsed.kokurikulerProjects || this.kokurikulerProjects;
                            this.grades = parsed.grades || this.grades;
                            this.settings = { ...this.settings, ...(parsed.settings || {}) };
                            this.logoDataUrl = parsed.logoDataUrl || this.logoDataUrl;
                            this.supabaseConfig = parsed.supabaseConfig || this.supabaseConfig;
                            
                            if (this.supabaseConfig.url && this.supabaseConfig.anonKey) {
                                this.connectSupabase(true);
                            }
                        } catch (e) {
                            console.error('Error parsing localStorage data', e);
                        }
                    }
                },
                saveToStorage() {
                    const data = {
                        students: this.students,
                        classesList: this.classesList,
                        classTeachers: this.classTeachers,
                        subjects: this.subjects,
                        learningObjectives: this.learningObjectives,
                        extracurriculars: this.extracurriculars,
                        kokurikulerProjects: this.kokurikulerProjects,
                        grades: this.grades,
                        settings: this.settings,
                        logoDataUrl: this.logoDataUrl,
                        supabaseConfig: this.supabaseConfig
                    };
                    localStorage.setItem('sdn_dadirejo_02_data', JSON.stringify(data));
                },
                async connectSupabase(autoConnect = false) {
                    if (!this.supabaseConfig.url || !this.supabaseConfig.anonKey) {
                        this.supabaseStatusMsg = 'URL dan Key Supabase tidak boleh kosong.';
                        this.supabaseConnected = false;
                        return;
                    }
                    try {
                        if (!window.supabase || typeof window.supabase.createClient !== 'function') {
                            throw new Error('Pustaka Supabase belum berhasil dimuat.');
                        }
                        this.supabaseClient = window.supabase.createClient(this.supabaseConfig.url, this.supabaseConfig.anonKey);
                        // The client is configured; actual access is verified when sync is attempted.
                        this.supabaseConnected = true;
                        this.supabaseStatusMsg = 'Klien Supabase siap. Akses tabel dan izin akan diverifikasi saat sinkronisasi.';
                        this.saveToStorage();
                    } catch (err) {
                        this.supabaseConnected = false;
                        this.supabaseStatusMsg = 'Gagal menghubungkan ke Supabase: ' + err.message;
                    }
                },
                async syncToSupabase() {
                    if (!this.supabaseConnected || !this.supabaseClient) return;
                    try {
                        this.supabaseStatusMsg = 'Mengunggah data ke Supabase...';
                        const payload = {
                            id: 'app_data_sdn_dadirejo_02',
                            data: {
                                students: this.students,
                                classesList: this.classesList,
                                classTeachers: this.classTeachers,
                                subjects: this.subjects,
                                learningObjectives: this.learningObjectives,
                                extracurriculars: this.extracurriculars,
                                kokurikulerProjects: this.kokurikulerProjects,
                                grades: this.grades,
                                settings: this.settings
                            },
                            updated_at: new Date()
                        };
                        const { error } = await this.supabaseClient.from('app_settings').upsert(payload);
                        if (error) throw error;
                        this.supabaseStatusMsg = 'Data berhasil diunggah ke Supabase Cloud!';
                    } catch (err) {
                        this.supabaseStatusMsg = 'Gagal mengunggah ke Supabase: ' + err.message;
                    }
                },
                async syncFromSupabase() {
                    if (!this.supabaseConnected || !this.supabaseClient) return;
                    try {
                        this.supabaseStatusMsg = 'Mengunduh data dari Supabase...';
                        const { data, error } = await this.supabaseClient.from('app_settings').select('data').eq('id', 'app_data_sdn_dadirejo_02').single();
                        if (error) throw error;
                        if (data && data.data) {
                            const cloudData = data.data;
                            this.students = cloudData.students || this.students;
                            this.classesList = cloudData.classesList || this.classesList;
                            this.classTeachers = cloudData.classTeachers || this.classTeachers;
                            this.subjects = cloudData.subjects || this.subjects;
                            this.learningObjectives = cloudData.learningObjectives || this.learningObjectives;
                            this.extracurriculars = cloudData.extracurriculars || this.extracurriculars;
                            this.kokurikulerProjects = cloudData.kokurikulerProjects || this.kokurikulerProjects;
                            this.grades = cloudData.grades || this.grades;
                            this.settings = cloudData.settings || this.settings;
                            this.saveToStorage();
                            this.supabaseStatusMsg = 'Data berhasil diunduh dari Supabase Cloud!';
                        }
                    } catch (err) {
                        this.supabaseStatusMsg = 'Gagal mengunduh dari Supabase: ' + err.message;
                    }
                },
                getClassesObjects() {
                    if (!this.classTeachers) this.classTeachers = {};
                    return this.classesList.map(k => ({
                        nama: k,
                        wali: this.classTeachers[k] || ''
                    }));
                },
                submitNewClass() {
                    const nama = String(this.newKelas ?? '').trim().replace(/\s+/g, ' ');
                    const wali = String(this.newWali ?? '').trim();
                    if (!nama) {
                        alert('Nama kelas/rombel harus diisi.');
                        return;
                    }
                    const berhasil = this.addClass(nama, wali);
                    if (berhasil) {
                        this.newKelas = '';
                        this.newWali = '';
                    }
                },
                addClass(namaKelas, namaWali) {
                    const nama = String(namaKelas ?? '').trim().replace(/\s+/g, ' ');
                    const wali = String(namaWali ?? '').trim();
                    if (!nama) {
                        alert('Nama kelas/rombel harus diisi.');
                        return false;
                    }
                    const existing = this.classesList.find(k => String(k).trim().toLocaleLowerCase() === nama.toLocaleLowerCase());
                    if (existing) {
                        alert('Kelas/rombel "' + existing + '" sudah ada. Gunakan nama kelas yang berbeda.');
                        return false;
                    }
                    if (!this.classTeachers) this.classTeachers = {};
                    // Reassign the array so Alpine reliably refreshes every dropdown and the class table.
                    this.classesList = [...this.classesList, nama];
                    this.classTeachers[nama] = wali;
                    try {
                        this.saveToStorage();
                        return true;
                    } catch (err) {
                        this.classesList = this.classesList.filter(k => k !== nama);
                        delete this.classTeachers[nama];
                        alert('Kelas gagal disimpan ke penyimpanan browser: ' + err.message);
                        return false;
                    }
                },
                updateClassWali(namaKelas, namaWali) {
                    if (!this.classTeachers) this.classTeachers = {};
                    // Store a clean string keyed by the exact class/rombel name.
                    this.classTeachers[namaKelas] = String(namaWali ?? '').trim();
                    this.saveToStorage();
                },
                getClassTeacher(namaKelas) {
                    const wali = this.classTeachers && this.classTeachers[namaKelas];
                    return (wali && String(wali).trim()) || this.settings.waliKelas || '';
                },
                removeClass(namaKelas) {
                    if (this.students.some(s => s.kelas === namaKelas)) {
                        alert('Kelas masih memiliki siswa. Pindahkan siswa ke kelas lain sebelum menghapus kelas ini.');
                        return;
                    }
                    if (!confirm('Hapus kelas ' + namaKelas + '?')) return;
                    this.classesList = this.classesList.filter(k => k !== namaKelas);
                    if (this.classTeachers && this.classTeachers[namaKelas]) {
                        delete this.classTeachers[namaKelas];
                    }
                    this.saveToStorage();
                },
                getStudent(id) {
                    return this.students.find(s => s.id == id) || {};
                },
                getGrade(studentId, mapelName) {
                    const key = studentId + '_' + mapelName;
                    if (!this.grades[key]) {
                        this.grades[key] = { harian: '', sts: '', sas: '', akhir: '', deskripsi: '' };
                    }
                    return this.grades[key];
                },
                saveGrades() {
                    try {
                        this.saveToStorage();
                        alert('Nilai berhasil disimpan pada browser ini.');
                    } catch (err) {
                        console.error('Gagal menyimpan nilai:', err);
                        alert('Nilai belum berhasil disimpan. Penyimpanan browser mungkin penuh atau dinonaktifkan. Pesan: ' + (err && err.message ? err.message : err));
                    }
                },
                setAssessmentScore(studentId, mapelName, field, rawValue) {
                    const g = this.getGrade(studentId, mapelName);
                    g[field] = rawValue === '' ? '' : Math.max(0, Math.min(100, Number(rawValue)));
                    this.calcGrade(studentId, mapelName);
                },
                setGradeDescription(studentId, mapelName, value) {
                    const g = this.getGrade(studentId, mapelName);
                    g.deskripsi = String(value ?? '');
                    this.saveToStorage();
                },
                setCpScore(studentId, mapelName, cpId, rawValue) {
                    const g = this.getGrade(studentId, mapelName);
                    if (!g.cpScores || typeof g.cpScores !== 'object') g.cpScores = {};
                    // Empty field remains empty; zero is a valid entered score.
                    g.cpScores[String(cpId)] = rawValue === '' ? '' : Math.max(0, Math.min(100, Number(rawValue)));
                    // Generate before attempting storage so a storage issue cannot block the UI update.
                    this.updateCpDescription(studentId, mapelName);
                    this.calcGrade(studentId, mapelName);
                },
                getKktpFor(kelas, mapelName) {
                    if (!this.settings.kktpPerKelasMapel || typeof this.settings.kktpPerKelasMapel !== 'object') this.settings.kktpPerKelasMapel = {};
                    const key = String(kelas || '').trim() + '||' + String(mapelName || '').trim();
                    const value = Number(this.settings.kktpPerKelasMapel[key]);
                    if (this.settings.kktpPerKelasMapel[key] !== undefined && this.settings.kktpPerKelasMapel[key] !== '' && Number.isFinite(value)) return Math.max(0, Math.min(100, value));
                    const fallback = Number(this.settings.kktp);
                    return Number.isFinite(fallback) ? Math.max(0, Math.min(100, fallback)) : 75;
                },
                setKktpFor(kelas, mapelName, rawValue) {
                    if (!this.settings.kktpPerKelasMapel || typeof this.settings.kktpPerKelasMapel !== 'object') this.settings.kktpPerKelasMapel = {};
                    const value = Number(rawValue);
                    if (!kelas || !mapelName || rawValue === '' || !Number.isFinite(value) || value < 0 || value > 100) {
                        alert('KKTP harus berupa angka 0 sampai 100.');
                        return;
                    }
                    this.settings.kktpPerKelasMapel[String(kelas).trim() + '||' + String(mapelName).trim()] = value;
                    this.saveToStorage();
                },
                getAutoDescription(studentId, mapelName) {
                    const student = this.students.find(s => String(s.id) === String(studentId));
                    if (!student) return '';
                    const norm = value => String(value ?? '').trim().toLocaleLowerCase();
                    const cps = this.learningObjectives.filter(cp =>
                        norm(cp.kelas) === norm(student.kelas) &&
                        norm(cp.mapel) === norm(mapelName) &&
                        String(cp.text ?? '').trim() !== ''
                    );
                    if (!cps.length) return '';
                    const grade = this.getGrade(studentId, mapelName);
                    const scores = cps.map(cp => {
                        const scoreMap = grade.cpScores || {};
                        const raw = scoreMap[String(cp.id)];
                        const value = raw !== undefined && raw !== null && String(raw).trim() !== '' ? Number(raw) : NaN;
                        return { cp, value };
                    });
                    // Only show a generated description after every listed CP/TP has a valid score.
                    if (scores.some(item => !Number.isFinite(item.value) || item.value < 0 || item.value > 100)) return '';
                    const kktp = this.getKktpFor(student.kelas, mapelName);
                    const achieved = scores.filter(item => item.value >= kktp).sort((a, b) => b.value - a.value);
                    const needsPractice = scores.filter(item => item.value < kktp).sort((a, b) => a.value - b.value);
                    const cleanText = item => String(item.cp.text || '').trim().replace(/[.!?]+$/, '');
                    const strongest = scores.slice().sort((a, b) => b.value - a.value)[0];
                    const lowest = scores.slice().sort((a, b) => a.value - b.value)[0];
                    const strongestText = strongest ? cleanText(strongest).toLowerCase() : 'tujuan pembelajaran';
                    const lowestText = lowest ? cleanText(lowest).toLowerCase() : 'tujuan pembelajaran';
                    return 'Peserta didik mampu memahami ' + strongestText +
                        ' dengan baik dan butuh bimbingan pada ' + lowestText + '.';
                },
                updateCpDescription(studentId, mapelName) {
                    const description = this.getAutoDescription(studentId, mapelName);
                    if (!description) return;
                    const grade = this.getGrade(studentId, mapelName);
                    grade.deskripsi = description;
                    try {
                        this.saveToStorage();
                    } catch (err) {
                        console.warn('Deskripsi dibuat di layar, tetapi penyimpanan browser gagal:', err);
                    }
                },
                calcGrade(studentId, mapelName) {
                    const g = this.getGrade(studentId, mapelName);
                    const cpValues = Object.values(g.cpScores || {}).filter(value => value !== '' && value !== null && value !== undefined && Number.isFinite(Number(value))).map(Number);
                    const nilaiHarian = cpValues.length ? cpValues.reduce((sum, value) => sum + Math.max(0, Math.min(100, value)), 0) / cpValues.length : g.harian;
                    const components = [
                        { value: nilaiHarian, weight: 0.4 },
                        { value: g.sts, weight: 0.3 },
                        { value: g.sas, weight: 0.3 }
                    ].filter(item => item.value !== '' && item.value !== null && item.value !== undefined && Number.isFinite(Number(item.value)));
                    for (const item of components) {
                        item.value = Math.max(0, Math.min(100, Number(item.value)));
                    }
                    g.akhir = components.length
                        ? Math.round(components.reduce((sum, item) => sum + item.value * item.weight, 0) /
                            components.reduce((sum, item) => sum + item.weight, 0))
                        : '';
                    try {
                        this.saveToStorage();
                    } catch (err) {
                        console.warn('Nilai berubah di layar, tetapi penyimpanan browser gagal:', err);
                    }
                },
                uploadCoverLogo(event) {
                    const file = event.target.files && event.target.files[0];
                    if (!file) return;
                    if (!/^image\/(png|jpeg|webp)$/.test(file.type)) {
                        alert('Pilih berkas gambar PNG, JPG, atau WebP.');
                        event.target.value = '';
                        return;
                    }
                    if (file.size > 8 * 1024 * 1024) {
                        alert('Ukuran gambar maksimal 8 MB.');
                        event.target.value = '';
                        return;
                    }
                    const reader = new FileReader();
                    reader.onload = (e) => {
                        const img = new Image();
                        img.onload = () => {
                            const maxSize = 600;
                            const scale = Math.min(1, maxSize / Math.max(img.width, img.height));
                            const canvas = document.createElement('canvas');
                            canvas.width = Math.max(1, Math.round(img.width * scale));
                            canvas.height = Math.max(1, Math.round(img.height * scale));
                            const ctx = canvas.getContext('2d');
                            ctx.clearRect(0, 0, canvas.width, canvas.height);
                            ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
                            this.logoDataUrl = canvas.toDataURL('image/png');
                            try {
                                this.saveToStorage();
                                alert('Logo sampul berhasil diperbarui.');
                            } catch (err) {
                                this.logoDataUrl = '';
                                alert('Logo tidak dapat disimpan. Coba gunakan gambar yang lebih kecil.');
                            }
                            event.target.value = '';
                        };
                        img.onerror = () => {
                            alert('Gambar tidak dapat dibaca. Silakan pilih gambar lain.');
                            event.target.value = '';
                        };
                        img.src = e.target.result;
                    };
                    reader.onerror = () => {
                        alert('Gagal membaca berkas gambar.');
                        event.target.value = '';
                    };
                    reader.readAsDataURL(file);
                },
                removeCoverLogo() {
                    if (!confirm('Hapus logo dari sampul raport?')) return;
                    this.logoDataUrl = '';
                    this.saveToStorage();
                },
                backupData() {
                    const data = localStorage.getItem('sdn_dadirejo_02_data') || JSON.stringify({
                        students: this.students, classesList: this.classesList, classTeachers: this.classTeachers,
                        subjects: this.subjects, learningObjectives: this.learningObjectives,
                        extracurriculars: this.extracurriculars, kokurikulerProjects: this.kokurikulerProjects,
                        grades: this.grades, settings: this.settings, logoDataUrl: this.logoDataUrl, supabaseConfig: this.supabaseConfig
                    }, null, 2);
                    const blob = new Blob([data], { type: 'application/json;charset=utf-8' });
                    const url = URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = url;
                    a.download = 'backup_sdn_dadirejo_02.json';
                    a.click();
                    URL.revokeObjectURL(url);
                },
                restoreData(event) {
                    const file = event.target.files[0];
                    if (!file) return;
                    const reader = new FileReader();
                    reader.onload = (e) => {
                        try {
                            const parsed = JSON.parse(e.target.result);
                            if (!parsed || typeof parsed !== 'object' || Array.isArray(parsed)) {
                                throw new Error('Struktur berkas tidak sesuai.');
                            }
                            const hasKnownField = ['students', 'classesList', 'subjects', 'grades', 'settings']
                                .some(key => Object.prototype.hasOwnProperty.call(parsed, key));
                            if (!hasKnownField) throw new Error('Berkas bukan cadangan aplikasi ini.');
                            if (!confirm('Pulihkan cadangan? Data aplikasi saat ini akan diganti.')) return;
                            localStorage.setItem('sdn_dadirejo_02_data', JSON.stringify(parsed));
                            this.initData();
                            alert('Cadangan berhasil dipulihkan.');
                        } catch (err) {
                            alert('Gagal memulihkan cadangan: ' + err.message);
                        } finally {
                            event.target.value = '';
                        }
                    };
                    reader.readAsText(file);
                }
            }
        }

        function studentModule() {
            return {
                searchQuery: '',
                filterKelas: '',
                modalOpen: false,
                isEdit: false,
                form: { id: null, nis: '', nisn: '', nama: '', jk: 'L', kelas: 'Kelas 1A', tmpLahir: 'Pati', tglLahir: '2018-01-01', agama: 'Islam', pendidikanSebelumnya: 'TK', alamat: '', desa: 'Dadirejo', kecamatan: 'Margorejo', kabupaten: 'Pati', ayah: '', pekAyah: '', ibu: '', pekIbu: '', telepon: '', sakit: 0, izin: 0, alpha: 0 },
                get filteredStudents() {
                    return this.students.filter(s => {
                        const matchQuery = s.nama.toLowerCase().includes(this.searchQuery.toLowerCase()) || s.nis.includes(this.searchQuery);
                        const matchKelas = this.filterKelas === '' || s.kelas === this.filterKelas;
                        return matchQuery && matchKelas;
                    });
                },
                openStudentModal() {
                    this.isEdit = false;
                    this.form = { id: Date.now(), nis: '', nisn: '', nama: '', jk: 'L', kelas: this.classesList[0] || 'Kelas 1A', tmpLahir: 'Pati', tglLahir: '2018-01-01', agama: 'Islam', pendidikanSebelumnya: 'TK', alamat: '', desa: 'Dadirejo', kecamatan: 'Margorejo', kabupaten: 'Pati', ayah: '', pekAyah: '', ibu: '', pekIbu: '', telepon: '', sakit: 0, izin: 0, alpha: 0 };
                    this.modalOpen = true;
                },
                editStudent(s) {
                    this.isEdit = true;
                    this.form = { ...s };
                    this.modalOpen = true;
                },
                saveStudent() {
                    if (this.isEdit) {
                        const idx = this.students.findIndex(s => s.id === this.form.id);
                        if (idx !== -1) this.students[idx] = { ...this.form };
                    } else {
                        this.students.push({ ...this.form, id: Date.now() });
                    }
                    this.saveToStorage();
                    this.modalOpen = false;
                },
                deleteStudent(id) {
                    const student = this.students.find(s => s.id === id);
                    if (!student || !confirm('Hapus data siswa ' + student.nama + '?')) return;
                    this.students = this.students.filter(s => s.id !== id);
                    Object.keys(this.grades || {}).forEach(key => {
                        if (key.startsWith(String(id) + '_')) delete this.grades[key];
                    });
                    this.saveToStorage();
                },
                downloadImportTemplate() {
                    const headers = [
                        'NIS', 'NISN', 'Nama Lengkap', 'JK', 'Kelas', 'Tempat Lahir', 'Tanggal Lahir',
                        'Agama', 'Pendidikan Sebelumnya', 'Alamat', 'Desa', 'Kecamatan', 'Kabupaten',
                        'Nama Ayah', 'Pekerjaan Ayah', 'Nama Ibu', 'Pekerjaan Ibu', 'Telepon'
                    ];
                    if (typeof XLSX === 'undefined') {
                        alert('Fitur Excel belum termuat. Periksa koneksi internet, lalu muat ulang aplikasi.');
                        return;
                    }
                    const ws = XLSX.utils.aoa_to_sheet([headers, Array(headers.length).fill('')]);
                    ws['!cols'] = headers.map(h => ({ wch: Math.max(14, h.length + 3) }));
                    const wb = XLSX.utils.book_new();
                    XLSX.utils.book_append_sheet(wb, ws, 'Data Siswa');
                    XLSX.writeFile(wb, 'Templat_Import_Data_Siswa_SDN_Dadirejo_02.xlsx');
                },
                handleFileUpload(event) {
                    const file = event.target.files[0];
                    if (!file) return;
                    const reader = new FileReader();
                    reader.onload = (e) => {
                        try {
                            let text = '';
                            const extension = (file.name.split('.').pop() || '').toLowerCase();
                            if (extension === 'xlsx' || extension === 'xls') {
                                if (typeof XLSX === 'undefined') throw new Error('Pustaka pembaca Excel belum termuat. Periksa koneksi internet, lalu muat ulang aplikasi.');
                                const workbook = XLSX.read(e.target.result, { type: 'array', cellDates: false });
                                const firstSheet = workbook.Sheets[workbook.SheetNames[0]];
                                if (!firstSheet) throw new Error('Berkas Excel tidak memiliki lembar kerja.');
                                text = XLSX.utils.sheet_to_csv(firstSheet, { FS: ',', RS: '\n' });
                            } else {
                                text = String(e.target.result || '');
                            }
                            text = text.replace(/^\uFEFF/, '');
                            const firstLine = text.split(/\r?\n/).find(line => line.trim());
                            if (!firstLine) throw new Error('Berkas CSV kosong.');
                            const delimiter = (firstLine.match(/;/g) || []).length > (firstLine.match(/,/g) || []).length ? ';' : ',';
                            const parseRow = (line) => {
                                const out = [];
                                let value = '', quoted = false;
                                for (let i = 0; i < line.length; i++) {
                                    const ch = line[i];
                                    if (ch === '"' && quoted && line[i + 1] === '"') { value += '"'; i++; }
                                    else if (ch === '"') quoted = !quoted;
                                    else if (ch === delimiter && !quoted) { out.push(value.trim()); value = ''; }
                                    else value += ch;
                                }
                                out.push(value.trim());
                                return out;
                            };
                            const lines = text.split(/\r?\n/).filter(line => line.trim());
                            const headers = parseRow(lines.shift()).map(h => h.toLowerCase().replace(/[\s_/-]+/g, ''));
                            const aliases = {
                                nis: ['nis', 'nomorinduksiswa'], nisn: ['nisn'], nama: ['nama', 'namalengkap', 'namasiswa'],
                                jk: ['jk', 'jeniskelamin', 'lp'], kelas: ['kelas', 'rombel'], tmpLahir: ['tempatlahir', 'tmplahir'],
                                tglLahir: ['tanggallahir', 'tgllahir'], agama: ['agama'], pendidikanSebelumnya: ['pendidikansebelumnya'],
                                alamat: ['alamat'], desa: ['desa', 'kelurahan'], kecamatan: ['kecamatan'], kabupaten: ['kabupaten'],
                                ayah: ['ayah', 'namaayah'], pekAyah: ['pekerjaanayah'], ibu: ['ibu', 'namaibu'],
                                pekIbu: ['pekerjaanibu'], telepon: ['telepon', 'hp', 'nomorhp']
                            };
                            const index = {};
                            Object.entries(aliases).forEach(([field, names]) => {
                                index[field] = headers.findIndex(h => names.includes(h));
                            });
                            if (index.nama < 0) throw new Error('Kolom Nama/Nama Lengkap wajib tersedia pada baris pertama Excel/CSV.');
                            const imported = [];
                            lines.forEach((line, rowIndex) => {
                                const cols = parseRow(line);
                                const get = field => index[field] >= 0 ? (cols[index[field]] || '').trim() : '';
                                const nama = get('nama');
                                if (!nama) return;
                                const jkRaw = get('jk').toUpperCase();
                                const kelas = get('kelas') || this.classesList[0] || 'Kelas 1';
                                if (!this.classesList.includes(kelas)) this.classesList.push(kelas);
                                imported.push({
                                    id: Date.now() + rowIndex, nis: get('nis'), nisn: get('nisn'), nama,
                                    jk: ['L', 'P'].includes(jkRaw) ? jkRaw : '',
                                    kelas, tmpLahir: get('tmpLahir'), tglLahir: get('tglLahir'), agama: get('agama'),
                                    pendidikanSebelumnya: get('pendidikanSebelumnya'), alamat: get('alamat'), desa: get('desa'),
                                    kecamatan: get('kecamatan'), kabupaten: get('kabupaten'), ayah: get('ayah'),
                                    pekAyah: get('pekAyah'), ibu: get('ibu'), pekIbu: get('pekIbu'), telepon: get('telepon'),
                                    sakit: 0, izin: 0, alpha: 0
                                });
                            });
                            if (!imported.length) throw new Error('Tidak ada baris siswa valid yang dapat diimpor.');
                            const existingNis = new Set(this.students.map(s => String(s.nis || '').trim()).filter(Boolean));
                            const unique = imported.filter(s => !s.nis || !existingNis.has(String(s.nis).trim()));
                            this.students.push(...unique);
                            this.saveToStorage();
                            alert('Impor selesai: ' + unique.length + ' siswa ditambahkan. Baris tanpa nama atau NIS duplikat dilewati.');
                        } catch (err) {
                            alert('Impor Excel/CSV gagal: ' + err.message);
                        } finally {
                            event.target.value = '';
                        }
                    };
                    if (/\.(xlsx|xls)$/i.test(file.name)) reader.readAsArrayBuffer(file);
                    else reader.readAsText(file, 'UTF-8');
                }
            }
        }
    </script>

    <!-- Fallback submit handler khusus menu Tambah Kelas -->
    <script>
    document.addEventListener('DOMContentLoaded', function () {
        var form = document.getElementById('tambah-kelas-form');
        if (!form) return;
        form.addEventListener('submit', function (event) {
            event.preventDefault();
            var namaInput = document.getElementById('input-nama-kelas');
            var waliInput = document.getElementById('input-wali-kelas');
            var nama = (namaInput && namaInput.value || '').trim().replace(/\s+/g, ' ');
            var wali = (waliInput && waliInput.value || '').trim();
            if (!nama) { alert('Nama kelas/rombel harus diisi.'); if (namaInput) namaInput.focus(); return; }
            try {
                var root = document.querySelector('body[x-data]');
                var state = window.Alpine && root ? window.Alpine.$data(root) : null;
                if (!state || typeof state.addClass !== 'function') {
                    alert('Aplikasi belum selesai dimuat. Muat ulang halaman, lalu coba lagi.');
                    return;
                }
                var added = state.addClass(nama, wali);
                if (added) {
                    state.newKelas = ''; state.newWali = '';
                    if (namaInput) namaInput.value = '';
                    if (waliInput) waliInput.value = '';
                    if (namaInput) namaInput.focus();
                }
            } catch (error) {
                console.error('Gagal menambahkan kelas:', error);
                alert('Kelas belum berhasil ditambahkan: ' + (error && error.message ? error.message : error));
            }
        });
    });
    </script>
