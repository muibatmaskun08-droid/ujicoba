<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistem Penilaian & Administrasi Rapor - SDN Dadirejo 02</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Alpine.js -->
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <!-- Excel (XLSX) dan Supabase JS Client -->
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
        body { font-family: 'Inter', sans-serif; }
        @page {
            size: 21.5cm 33cm;
            margin: 1cm;
        }
        @media print {
            html, body { width: 100% !important; height: auto !important; min-height: 0 !important; margin: 0 !important; padding: 0 !important; overflow: visible !important; background: #fff !important; color: #000 !important; }
            body { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
            .no-print, aside, header.no-print, button { display: none !important; }
            .flex.h-screen, .flex-1.flex.flex-col.h-screen, main { display: block !important; height: auto !important; min-height: 0 !important; overflow: visible !important; width: 100% !important; max-width: none !important; margin: 0 !important; padding: 0 !important; }
            main { background: #fff !important; }
            main > div { display: none !important; }
            main > div[x-show="currentTab === 'raport'"] { display: block !important; }
            body.print-sampul main > div { display: none !important; }
            body.print-sampul main > div[x-show="currentTab === 'sampul'"] { display: block !important; }
            body.print-sampul .sampul-print-area { display: block !important; width: 100% !important; max-width: none !important; margin: 0 !important; padding: 1.5cm !important; box-shadow: none !important; border: none !important; }
            body.print-sampul main > div[x-show="currentTab === 'sampul'"] .no-print { display: none !important; }
            body.print-rekap main > div { display: none !important; }
            body.print-rekap main > div[x-show="currentTab === 'rekap'"] { display: block !important; }
            body.print-rekap .rekap-print-area { display: block !important; overflow: visible !important; }
            body.print-rekap table { min-width: 0 !important; }
            body.print-raport main > div { display: none !important; }
            body.print-raport main > div[x-show="currentTab === 'raport'"] { display: block !important; }
            .folio-print { display: block !important; page: auto; width: 100% !important; max-width: none !important; height: auto !important; min-height: 0 !important; margin: 0 !important; padding: 0 !important; overflow: visible !important; box-shadow: none !important; border: none !important; border-radius: 0 !important; }
            .print-only { display: block !important; }
            .print-page-break { break-after: page; page-break-after: always; }
            table { width: 100% !important; border-collapse: collapse !important; break-inside: auto; page-break-inside: auto; }
            thead { display: table-header-group; }
            tfoot { display: table-footer-group; }
            tr, img, .signature-block { break-inside: avoid; page-break-inside: avoid; }
            h1, h2, h3, h4 { break-after: avoid; page-break-after: avoid; }
            .space-y-6 > :not([hidden]) ~ :not([hidden]) { margin-top: 1rem !important; }
            .bg-slate-50 { background: #fff !important; }
            .text-emerald-800, .text-emerald-700 { color: #000 !important; }
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 antialiased" x-data="appData()" x-init="initData()">

    <!-- App Container -->
    <div class="flex h-screen overflow-hidden">
        
        <!-- SIDEBAR (No Print) -->
        <aside :class="sidebarOpen ? 'translate-x-0' : '-translate-x-full'" class="no-print fixed inset-y-0 left-0 z-50 w-64 bg-slate-900 text-slate-200 transition-transform duration-300 ease-in-out lg:static lg:translate-x-0 flex flex-col shadow-xl">
            <!-- Sidebar Header -->
            <div class="flex items-center justify-between px-5 py-4 bg-emerald-700 text-white">
                <div class="flex items-center space-x-3">
                    <div class="bg-white p-1 rounded-lg shadow flex items-center justify-center w-10 h-10 shrink-0">
                        <img src="data:image/png;base64,-------------------------------P0mXW+ODrYPoSIHUcJC2tnqTGvPL3V3Ln7YPuPf/C9P/vzvz7Y29vs7xuPW83m5Yc3k0GU9CJJLBIKD3lGo/iaUQDvDUxFShoWWbHougyHjr0tFz3E38fX8e0bnTUpya---------P0mXW+55T+7qqXE8MgG2DdpDo7FahLIrysJ0FuwYB98PWtJpPHOOpufURx+p5Xn1+rl5Pc/zr+TlUzPY701NwPGT1uEJq7fPiadQVKOBNEME9M9cSy9FvfHvcx2gMPkp1H5Dj4YaKufPRsAyon8Tf/9qW03EA5pk3GeLCq2OEgdPBc0Mj5CshPU/Q0jwrqMmorGyp1fW5clLfvzUPH2sV3c1+zIwAP/umHX2uHP+rDUQDvDUxFShoWWbHougyHjr0tFz3E38fX8e0bnTUpya-P0mXW/aqABIQAwhQ9AgEyPIdl5uPZX1sh07klFZ5ZMBYxSqhp63GXcu7SrL1ttS6p8XCgEZ8Daqu7e3zI4vLAN9/e+9/fah4RGF6sHDR5988mmhWAzezGQq/vY778ydmLMsS2vdaLNkH5DyAyr/6I2O0nm8kWbinDTu6dZZHA7QxmCEl9QaPdsy83GUQDvDUxFShoWWbHougyHjr0tFz3E38fX8e0bnTUpya----P0mXW/djeQeevQK4IsZj0JlFApAKLCzgzBTeu8/Iy9A/Svh1gBWZxgTuT9J3HKR5Rl8Z5JS1eHlJRePpedd99ejUQDvDUxFShoWWbHougyHjr0tFz3E38fX8e0bnTUpya------------" alt="Logo SDN Dadirejo 02" class="w-full h-full object-contain">
                    </div>
                    <div>
                        <h1 class="font-bold text-sm leading-tight">SDN DADIREJO 02</h1>
                        <span class="text-xs text-emerald-200">Sistem Penilaian Raport</span>
                    </div>
                </div>
                <button @click="sidebarOpen = false" class="lg:hidden text-emerald-200 hover:text-white">
                    <i class="fa-solid fa-xmark text-xl"></i>
                </button>
            </div>

            <!-- Sidebar Navigation Links (14 Menus) -->
            <nav class="flex-1 overflow-y-auto px-3 py-4 space-y-1 text-sm scrollbar-thin scrollbar-thumb-slate-700">
                <template x-for="menu in menus" :key="menu.id">
                    <button @click="currentTab = menu.id; sidebarOpen = false" 
                        :class="currentTab === menu.id ? 'bg-emerald-600 text-white font-semibold shadow-md' : 'text-slate-300 hover:bg-slate-800 hover:text-white'"
                        class="w-full flex items-center space-x-3 px-3 py-2.5 rounded-lg transition-all text-left">
                        <i :class="menu.icon" class="w-5 text-center"></i>
                        <span x-text="menu.name"></span>
                    </button>
                </template>
            </nav>

            <!-- Sidebar Footer -->
            <div class="p-4 bg-slate-950 text-xs text-slate-400 border-t border-slate-800 text-center">
                <p>Kurikulum Merdeka 2026</p>
                <p class="text-[10px] text-slate-500 mt-0.5">Kab. Pati, Jawa Tengah</p>
            </div>
        </aside>

        <!-- MAIN CONTENT AREA -->
        <div class="flex-1 flex flex-col h-screen overflow-hidden">
            
            <!-- TOP NAVBAR -->
            <header class="no-print bg-white border-b border-slate-200 shadow-sm z-20 flex items-center justify-between px-6 py-3">
                <div class="flex items-center space-x-4">
                    <button @click="sidebarOpen = !sidebarOpen" class="text-slate-600 hover:text-emerald-700 lg:hidden focus:outline-none">
                        <i class="fa-solid fa-bars text-xl"></i>
                    </button>
                    <div>
                        <h2 class="text-lg font-bold text-slate-800 capitalize" x-text="getMenuName(currentTab)"></h2>
                        <p class="text-xs text-slate-500" x-text="[settings.namaSekolah, settings.kecamatanSekolah ? 'Kec. ' + settings.kecamatanSekolah : '', settings.kabupatenSekolah ? 'Kab. ' + settings.kabupatenSekolah : ''].filter(Boolean).join(', ')"></p>
                    </div>
                </div>
                <div class="flex items-center space-x-3">
                    <span class="text-xs bg-emerald-100 text-emerald-800 px-3 py-1 rounded-full font-medium hidden sm:inline-block">
                        <i class="fa-solid fa-circle text-[8px] text-emerald-600 mr-1.5"></i> Tahun Pelajaran <span x-text="settings.tahunPelajaran || '2025/2026'"></span>
                    </span>
                    <div class="h-8 w-8 rounded-full bg-emerald-700 text-white flex items-center font-bold text-xs justify-center shadow">
                        <span>W</span>
                    </div>
                </div>
            </header>

            <!-- DYNAMIC VIEW PORT -->
            <main class="flex-1 overflow-y-auto p-4 lg:p-6 bg-slate-50">
                
                <!-- 1. LAYAR UTAMA (DASHBOARD) -->
                <div x-show="currentTab === 'dashboard'" class="space-y-6">
                    <!-- Welcome Banner -->
                    <div class="bg-gradient-to-r from-emerald-700 to-teal-800 rounded-2xl p-6 text-white shadow-lg flex flex-col md:flex-row justify-between items-center">
                        <div class="space-y-2 mb-4 md:mb-0">
                            <span class="bg-emerald-600 text-xs px-3 py-1 rounded-full font-semibold uppercase tracking-wider">Dashboard Utama</span>
                            <h2 class="text-2xl lg:text-3xl font-bold">Selamat Datang di Sistem Penilaian <span x-text="settings.namaSekolah || 'SDN Dadirejo 02'"></span></h2>
                            <p class="text-emerald-100 text-sm max-w-2xl">Aplikasi administrasi raport terpadu berbasis Kurikulum Merdeka untuk pengelolaan data siswa, penilaian formatif/sumatif, kokurikuler, hingga cetak raport semester.</p>
                        </div>
                        <div class="bg-white/10 backdrop-blur p-4 rounded-xl border border-white/20 text-center min-w-[200px]">
                            <p class="text-xs text-emerald-200">Kepala Sekolah</p>
                            <p class="font-bold text-base mt-0.5" x-text="settings.kepalaSekolah">Kepala Sekolah</p>
                            <button @click="currentTab = 'profil_sekolah'; sidebarOpen = false" class="mt-2 text-xs bg-white text-emerald-800 px-3 py-1.5 rounded font-semibold hover:bg-emerald-50 transition"><i class="fa-solid fa-pen-to-square mr-1"></i> Ubah Profil</button>
                        </div>
                    </div>

                    <!-- Statistics Cards -->
                    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
                        <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex items-center space-x-4">
                            <div class="p-3 bg-emerald-100 text-emerald-700 rounded-xl text-xl"><i class="fa-solid fa-users"></i></div>
                            <div>
                                <p class="text-xs text-slate-500 font-medium">Total Siswa</p>
                                <h3 class="text-2xl font-bold text-slate-800" x-text="students.length">0</h3>
                            </div>
                        </div>
                        <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex items-center space-x-4">
                            <div class="p-3 bg-blue-100 text-blue-700 rounded-xl text-xl"><i class="fa-solid fa-book-open"></i></div>
                            <div>
                                <p class="text-xs text-slate-500 font-medium">Mata Pelajaran</p>
                                <h3 class="text-2xl font-bold text-slate-800" x-text="subjects.length">0</h3>
                            </div>
                        </div>
                        <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex items-center space-x-4">
                            <div class="p-3 bg-amber-100 text-amber-700 rounded-xl text-xl"><i class="fa-solid fa-puzzle-piece"></i></div>
                            <div>
                                <p class="text-xs text-slate-500 font-medium">Ekstrakurikuler</p>
                                <h3 class="text-2xl font-bold text-slate-800" x-text="extracurriculars.length">0</h3>
                            </div>
                        </div>
                        <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex items-center space-x-4">
                            <div class="p-3 bg-purple-100 text-purple-700 rounded-xl text-xl"><i class="fa-solid fa-book-bookmark"></i></div>
                            <div>
                                <p class="text-xs text-slate-500 font-medium">Jumlah Mulok</p>
                                <h3 class="text-2xl font-bold text-slate-800" x-text="subjects.filter(s => s.kategori === 'Mulok').length">0</h3>
                            </div>
                        </div>
                        <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex items-center space-x-4">
                            <div class="p-3 bg-rose-100 text-rose-700 rounded-xl text-xl"><i class="fa-solid fa-seedling"></i></div>
                            <div>
                                <p class="text-xs text-slate-500 font-medium">Kokurikuler</p>
                                <h3 class="text-2xl font-bold text-slate-800" x-text="kokurikulerProjects.length">0</h3>
                            </div>
                        </div>
                    </div>


                </div>

                <div x-show="currentTab === 'profil_sekolah'" class="space-y-6">
                    <!-- MENU EDIT PROFIL SEKOLAH -->
                    <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6 space-y-5">
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-100 pb-4">
                            <div class="flex items-center gap-3">
                                <div class="bg-emerald-700 text-white p-3 rounded-xl"><i class="fa-solid fa-school text-xl"></i></div>
                                <div>
                                    <h3 class="font-bold text-slate-800 text-lg">Edit Profil Sekolah</h3>
                                    <p class="text-xs text-slate-500">Lengkapi identitas sekolah. Data disimpan di browser dan digunakan pada tampilan aplikasi.</p>
                                </div>
                            </div>
                            <button type="button" @click="saveToStorage(); alert('Profil sekolah berhasil disimpan.')" class="bg-emerald-700 hover:bg-emerald-800 text-white px-4 py-2.5 rounded-lg text-sm font-semibold"><i class="fa-solid fa-floppy-disk mr-2"></i>Simpan Profil Sekolah</button>
                        </div>
                        <form id="profil-sekolah-form" @submit.prevent="saveToStorage(); alert('Profil sekolah berhasil disimpan.')" class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
                            <div class="md:col-span-2"><label class="block font-medium text-slate-700 mb-1">Nama Sekolah *</label><input required type="text" x-model="settings.namaSekolah" class="w-full p-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-500" placeholder="Nama lengkap sekolah"></div>
                            <div><label class="block font-medium text-slate-700 mb-1">NPSN</label><input type="text" x-model="settings.npsn" class="w-full p-2.5 border border-slate-300 rounded-lg" placeholder="Nomor Pokok Sekolah Nasional"></div>
                            <div><label class="block font-medium text-slate-700 mb-1">Status Sekolah</label><select x-model="settings.statusSekolah" class="w-full p-2.5 border border-slate-300 rounded-lg"><option value="Negeri">Negeri</option><option value="Swasta">Swasta</option></select></div>
                            <div class="md:col-span-2"><label class="block font-medium text-slate-700 mb-1">Alamat Sekolah</label><input type="text" x-model="settings.alamatSekolah" class="w-full p-2.5 border border-slate-300 rounded-lg" placeholder="Jalan, nomor, RT/RW"></div>
                            <div><label class="block font-medium text-slate-700 mb-1">Desa/Kelurahan</label><input type="text" x-model="settings.desaSekolah" class="w-full p-2.5 border border-slate-300 rounded-lg"></div>
                            <div><label class="block font-medium text-slate-700 mb-1">Kecamatan</label><input type="text" x-model="settings.kecamatanSekolah" class="w-full p-2.5 border border-slate-300 rounded-lg"></div>
                            <div><label class="block font-medium text-slate-700 mb-1">Kabupaten/Kota</label><input type="text" x-model="settings.kabupatenSekolah" class="w-full p-2.5 border border-slate-300 rounded-lg"></div>
                            <div><label class="block font-medium text-slate-700 mb-1">Provinsi</label><input type="text" x-model="settings.provinsiSekolah" class="w-full p-2.5 border border-slate-300 rounded-lg"></div>
                            <div><label class="block font-medium text-slate-700 mb-1">Kode Pos</label><input type="text" x-model="settings.kodePos" class="w-full p-2.5 border border-slate-300 rounded-lg"></div>
                            <div><label class="block font-medium text-slate-700 mb-1">Nomor Telepon Sekolah</label><input type="tel" x-model="settings.teleponSekolah" class="w-full p-2.5 border border-slate-300 rounded-lg"></div>
                            <div><label class="block font-medium text-slate-700 mb-1">Email Sekolah</label><input type="email" x-model="settings.emailSekolah" class="w-full p-2.5 border border-slate-300 rounded-lg"></div>
                            <div><label class="block font-medium text-slate-700 mb-1">Website Sekolah</label><input type="text" x-model="settings.websiteSekolah" class="w-full p-2.5 border border-slate-300 rounded-lg" placeholder="https://"></div>
                            <div><label class="block font-medium text-slate-700 mb-1">Akreditasi</label><select x-model="settings.akreditasi" class="w-full p-2.5 border border-slate-300 rounded-lg"><option value="">Pilih akreditasi</option><option>A</option><option>B</option><option>C</option><option>Belum Terakreditasi</option></select></div>
                            <div><label class="block font-medium text-slate-700 mb-1">Tahun Berdiri</label><input type="number" min="1800" max="2100" x-model="settings.tahunBerdiri" class="w-full p-2.5 border border-slate-300 rounded-lg"></div>
                            <div><label class="block font-medium text-slate-700 mb-1">Nama Kepala Sekolah</label><input type="text" x-model="settings.kepalaSekolah" class="w-full p-2.5 border border-slate-300 rounded-lg"></div>
                            <div><label class="block font-medium text-slate-700 mb-1">NIP Kepala Sekolah</label><input type="text" x-model="settings.nipKepsek" class="w-full p-2.5 border border-slate-300 rounded-lg"></div>
                            <div class="md:col-span-2"><label class="block font-medium text-slate-700 mb-1">Visi Sekolah</label><textarea rows="2" x-model="settings.visiSekolah" class="w-full p-2.5 border border-slate-300 rounded-lg" placeholder="Tuliskan visi sekolah"></textarea></div>
                            <div class="md:col-span-2"><label class="block font-medium text-slate-700 mb-1">Misi Sekolah</label><textarea rows="4" x-model="settings.misiSekolah" class="w-full p-2.5 border border-slate-300 rounded-lg" placeholder="Tuliskan misi sekolah"></textarea></div>
                            <div><label class="block font-medium text-slate-700 mb-1">KKTP</label><input type="number" min="0" max="100" x-model.number="settings.kktp" class="w-full p-2.5 border border-slate-300 rounded-lg"></div>
                            <div class="flex items-end"><button type="submit" class="w-full bg-emerald-700 hover:bg-emerald-800 text-white px-5 py-2.5 rounded-lg font-semibold"><i class="fa-solid fa-floppy-disk mr-2"></i>Simpan Profil Sekolah</button></div>
                        </form>
                        <div class="bg-emerald-50 border border-emerald-100 text-emerald-900 rounded-lg p-3 text-xs"><i class="fa-solid fa-circle-info mr-1"></i> Perubahan profil tersimpan pada browser ini. Untuk menjaga data, lakukan backup melalui menu Pengaturan &amp; Backup secara berkala.</div>
                    </div>
                </div>

                <!-- PENGATURAN TAHUN PELAJARAN -->
                <div x-show="currentTab === 'tahun_pelajaran'" class="space-y-6">
                    <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6 max-w-2xl">
                        <div class="flex items-center gap-3 border-b border-slate-100 pb-4 mb-5">
                            <div class="bg-emerald-100 text-emerald-700 p-3 rounded-xl"><i class="fa-solid fa-calendar-days text-xl"></i></div>
                            <div>
                                <h3 class="font-bold text-slate-800 text-lg">Mengganti Tahun Pelajaran</h3>
                                <p class="text-sm text-slate-500">Tahun pelajaran akan diperbarui pada bagian atas aplikasi dan identitas raport.</p>
                            </div>
                        </div>
                        <form @submit.prevent="settings.tahunPelajaran = String(settings.tahunPelajaran || '').trim(); if (!/^\d{4}\/\d{4}$/.test(settings.tahunPelajaran)) { alert('Format tahun pelajaran harus seperti 2025/2026.'); return; } saveToStorage(); alert('Tahun pelajaran berhasil disimpan: ' + settings.tahunPelajaran);" class="space-y-4">
                            <div>
                                <label class="block text-sm font-medium text-slate-700 mb-1">Tahun Pelajaran</label>
                                <input type="text" x-model="settings.tahunPelajaran" placeholder="Contoh: 2026/2027" pattern="[0-9]{4}/[0-9]{4}" required class="w-full p-3 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-500">
                                <p class="text-xs text-slate-500 mt-1">Gunakan format tahun awal/tahun akhir, misalnya 2026/2027.</p>
                            </div>
                            <button type="submit" class="bg-emerald-700 hover:bg-emerald-800 text-white px-5 py-2.5 rounded-lg font-semibold"><i class="fa-solid fa-floppy-disk mr-2"></i>Simpan Tahun Pelajaran</button>
                        </form>
                    </div>
                </div>

                <!-- 2. DATA SISWA -->
                <div x-show="currentTab === 'siswa'" class="space-y-6" x-data="studentModule()">
                    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
                        <div class="flex flex-wrap items-center gap-3 w-full md:w-auto">
                            <div class="relative flex-1 md:w-64">
                                <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400"><i class="fa-solid fa-search"></i></span>
                                <input type="text" x-model="searchQuery" placeholder="Cari nama atau NIS..." class="w-full pl-9 pr-4 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500">
                            </div>
                            <select x-model="filterKelas" class="py-2 px-3 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500">
                                <option value="">Semua Kelas</option>
                                <template x-for="k in classesList" :key="k">
                                    <option :value="k" x-text="k"></option>
                                </template>
                            </select>
                        </div>
                        <div class="flex flex-wrap items-center gap-2 w-full md:w-auto justify-end">
                            <button @click="downloadImportTemplate()" title="Unduh templat Excel untuk diisi sebelum impor data siswa" class="bg-sky-600 hover:bg-sky-700 text-white px-4 py-2 rounded-lg text-sm font-semibold transition flex items-center">
                                <i class="fa-solid fa-download mr-2"></i> Templat Import
                            </button>
